#!/usr/bin/env bash
# Compatibility wrapper: runs asb, never the old behavior.
set -euo pipefail

if ! command -v asb >/dev/null 2>&1; then
  echo "opencode-sandbox: asb not found in PATH." >&2
  echo "Install with: go install github.com/gustavoxffff/agentsandboxing/cmd/asb@latest" >&2
  echo "There is no fallback to the old script." >&2
  exit 127
fi

PROJECT="${PWD}"
if [ "$#" -gt 0 ] && [ -d "${1}" ]; then
  PROJECT="$(realpath "${1}")"
  shift
fi

args=(run -C "$PROJECT")
if [ ! -f "$PROJECT/asb.toml" ]; then
  echo "opencode-sandbox: warning: no asb.toml in $PROJECT; using --profile host (legacy behavior)" >&2
  args+=(--profile host)
fi

exec asb "${args[@]}" -- opencode --standalone "$@"
