#!/usr/bin/env bash
# Wrapper de compatibilidade: executa o asb, nunca o comportamento antigo.
set -euo pipefail

if ! command -v asb >/dev/null 2>&1; then
  echo "opencode-sandbox: asb não encontrado no PATH." >&2
  echo "Instale com: go install github.com/gustavoxffff/agentsandboxing/cmd/asb@latest" >&2
  echo "Não há fallback para o script antigo." >&2
  exit 127
fi

PROJECT="${PWD}"
if [ "$#" -gt 0 ] && [ -d "${1}" ]; then
  PROJECT="$(realpath "${1}")"
  shift
fi

args=(run -C "$PROJECT")
if [ ! -f "$PROJECT/asb.toml" ]; then
  echo "opencode-sandbox: aviso: sem asb.toml em $PROJECT; usando --profile host (comportamento legado)" >&2
  args+=(--profile host)
fi

exec asb "${args[@]}" -- opencode --standalone "$@"
